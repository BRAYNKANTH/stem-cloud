---
// Generated by tools/watch_anims.py: the island of a Watch animation (components/lesson/Step.astro).
import type { SiDict } from '../lib/si-lookup';
import CurrentElectricityWatch from './CurrentElectricityWatch';
import EquilibriumWatch from './EquilibriumWatch';
import FrictionWatch from './FrictionWatch';
import HydrostaticPressureWatch from './HydrostaticPressureWatch';
import MotionInAStraightLineWatch from './MotionInAStraightLineWatch';
import NewtonsLawsWatch from './NewtonsLawsWatch';
import ResultantForceWatch from './ResultantForceWatch';
import TurningEffectWatch from './TurningEffectWatch';
import WorkEnergyPowerWatch from './WorkEnergyPowerWatch';
import ElectricAppliancesWatch from './ElectricAppliancesWatch';
import ElectromagnetismWatch from './ElectromagnetismWatch';
import ElectronicsWatch from './ElectronicsWatch';
import GeometricalOpticsWatch from './GeometricalOpticsWatch';
import HeatWatch from './HeatWatch';
import WavesWatch from './WavesWatch';
interface Props { island: string; si: SiDict; stepId: string; seg?: [number, number, number] }
const { island, si, stepId, seg } = Astro.props;
---
{island === 'current-electricity' && <CurrentElectricityWatch client:visible si={si} stepId={stepId} seg={seg} />}
{island === 'equilibrium' && <EquilibriumWatch client:visible si={si} stepId={stepId} seg={seg} />}
{island === 'friction' && <FrictionWatch client:visible si={si} stepId={stepId} seg={seg} />}
{island === 'hydrostatic-pressure' && <HydrostaticPressureWatch client:visible si={si} stepId={stepId} seg={seg} />}
{island === 'motion-in-a-straight-line' && <MotionInAStraightLineWatch client:visible si={si} stepId={stepId} seg={seg} />}
{island === 'newtons-laws' && <NewtonsLawsWatch client:visible si={si} stepId={stepId} seg={seg} />}
{island === 'resultant-force' && <ResultantForceWatch client:visible si={si} stepId={stepId} seg={seg} />}
{island === 'turning-effect' && <TurningEffectWatch client:visible si={si} stepId={stepId} seg={seg} />}
{island === 'work-energy-power' && <WorkEnergyPowerWatch client:visible si={si} stepId={stepId} seg={seg} />}
{island === 'electric-appliances' && <ElectricAppliancesWatch client:visible si={si} stepId={stepId} seg={seg} />}
{island === 'electromagnetism' && <ElectromagnetismWatch client:visible si={si} stepId={stepId} seg={seg} />}
{island === 'electronics' && <ElectronicsWatch client:visible si={si} stepId={stepId} seg={seg} />}
{island === 'geometrical-optics' && <GeometricalOpticsWatch client:visible si={si} stepId={stepId} seg={seg} />}
{island === 'heat' && <HeatWatch client:visible si={si} stepId={stepId} seg={seg} />}
{island === 'waves' && <WavesWatch client:visible si={si} stepId={stepId} seg={seg} />}
