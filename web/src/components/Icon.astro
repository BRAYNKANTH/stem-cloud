---
// One drawn icon, the same shapes and styling as StemIcon() in public/static/ui-icons.js. Decorative by default
// (aria-hidden); pass label when the icon is the only content of a control.
import { FILL, STROKE, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  label?: string;
  class?: string;
}
const { name, label, class: extra } = Astro.props;
const filled = name in FILL;
const d = filled ? FILL[name as keyof typeof FILL] : STROKE[name as keyof typeof STROKE];
---
<span class:list={['ic', extra]} aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label}>
  <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path class:list={{ f: filled }} d={d} /></svg>
</span>
