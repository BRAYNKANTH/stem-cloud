# Set these in Vercel's environment settings. Never put real secrets in this file.
R2_MEDIA_ENABLED=0
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PRIVATE=stem-cloud-private
# Optional: a SEPARATE public bucket with a Cloudflare custom domain.
# Without these, existing public media remains on Vercel.
R2_BUCKET_PUBLIC=stem-cloud-public
R2_PUBLIC_BASE_URL=
