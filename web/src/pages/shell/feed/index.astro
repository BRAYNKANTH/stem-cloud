---
// Practice (the LearningFeed island): pick a chapter and its practice questions (content/practice) start at once, one
// per screen, swiped up like a reel; a bookmark in the corner keeps a question (#saved). It is the Practice tab of the
// bottom bar (BottomNav), and a lesson's finish step links its chapter here. Login-only like the lessons
// (web/scripts/private.mjs, stemcloud/routers/feed.py).
import AppLayout from '../../../layouts/AppLayout.astro';
import LearningFeed, { type Chapter, type Pool } from '../../../islands/LearningFeed';
import LangSwitch from '../../../islands/LangSwitch';
import BottomNav from '../../../islands/BottomNav';
import catalog from '../../../../../content/catalog.json';

interface Entry { id: string; subject: string; grade: number; slug: string; title: Chapter['title'] }
const chapters: Chapter[] = (catalog.lessons as Entry[]).map((l) => ({ id: l.id, title: l.title, url: `/learn/${l.subject}/g${l.grade}/${l.slug}/` }));
// each chapter with practice questions (content/practice): the page carries only the list; a chapter's questions are
// fetched when it is opened (/feed/<chapter>.json, stemcloud/routers/feed.py)
interface Q { id: string }
const POOLS = import.meta.glob<{ lesson: string; questions: Q[] }>('../../../../../content/practice/*/*.json', { eager: true, import: 'default' });
const slugOf = new Map((catalog.lessons as Entry[]).map((l) => [l.id, l.slug]));
const order = new Map((catalog.lessons as Entry[]).map((l, i) => [l.id, i]));
const pools: Pool[] = Object.values(POOLS).sort((a, b) => (order.get(a.lesson) ?? 99) - (order.get(b.lesson) ?? 99)).map((p) => ({
  slug: slugOf.get(p.lesson) ?? p.lesson, lesson: p.lesson, count: p.questions.length, prefix: (p.questions[0]?.id ?? '').replace(/-\d+$/, ''),
}));
---
<AppLayout title="Practice · STEM Cloud" description="Practise physics one question at a time: swipe up for the next." noindex>
  <header class="fd-header" slot="header">
    <a class="fd-home" href="#chapters"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" /></svg><span data-l="en">Chapters</span><span data-l="ta" lang="ta">பாடங்கள்</span><span data-l="si" lang="si">පරිච්ඡේද</span></a>
    <h1 class="fd-title"><span data-l="en">Practice</span><span data-l="ta" lang="ta">பயிற்சி</span><span data-l="si" lang="si">පුහුණුව</span> <small>beta</small></h1>
    <LangSwitch client:idle />
  </header>
  {/* opened on a chapter (or #saved): the chapter list is not painted first, so nothing jumps when the questions arrive */}
  <script is:inline>try { var h = decodeURIComponent(location.hash.slice(1)); if (h && h !== 'chapters') document.documentElement.classList.add('fd-deep'); } catch (e) {}</script>
  <LearningFeed client:load chapters={chapters} pools={pools} />
  <BottomNav slot="footer" here="practice" client:idle />
</AppLayout>

<style>
  :global(html), :global(body) { overscroll-behavior-y: none; }
  .fd-header { position: sticky; top: 0; z-index: 50; height: calc(56px + env(safe-area-inset-top)); display: flex; align-items: center; justify-content: space-between; gap: 8px;
               padding: env(safe-area-inset-top) var(--gutter) 0; background: var(--sc-ground); border-bottom: 1px solid var(--sc-line); }
  .fd-home { display: inline-flex; align-items: center; gap: 4px; min-height: var(--tap); font-weight: 700; text-decoration: none; }
  .fd-title { font-family: var(--font-head); font-size: 1.15rem; font-weight: 700; margin: 0; }
  .fd-title small { font: 700 .75rem var(--font-text); color: var(--sc-ink-2); background: var(--sc-mango-lt); padding: 2px 6px; border-radius: 6px; vertical-align: middle; }
  html:not([lang="ta"]):not([lang="si"]) :is(.fd-home, .fd-title) [data-l]:not([data-l="en"]),
  html[lang="ta"] :is(.fd-home, .fd-title) [data-l]:not([data-l="ta"]),
  html[lang="si"] :is(.fd-home, .fd-title) [data-l]:not([data-l="si"]) { display: none; }

  /* the reel: one question per screen, snapped, and each question fits its screen (the picture shrinks first) */
  :global(.fd) { height: calc(100dvh - var(--fd-head, 56px) - env(safe-area-inset-top) - var(--fd-bnav, 0px)); overflow-y: auto; scroll-snap-type: y mandatory; overscroll-behavior: contain; position: relative; overflow-anchor: none; }
  :global(.fd.is-list) { scroll-snap-type: none; }
  /* the bar over the reel: which question this is, and the bookmark in the corner (it stays while the cards pass) */
  :global(.fd-hud) { position: sticky; top: 0; z-index: 6; height: 0; }
  :global(.fd-score) { position: absolute; left: var(--gutter); top: 10px; max-width: calc(100% - var(--gutter) * 2 - 52px); padding: 5px 12px; border-radius: 999px; background: var(--sc-panel);
                       box-shadow: 0 2px 0 var(--sc-line); font-weight: 700; font-size: .85rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
  :global(.fd-pos) { color: var(--sc-ink-2); }
  :global(.fd-save) { position: absolute; right: calc(var(--gutter) - 6px); top: 4px; width: 48px; height: 48px; display: grid; place-items: center; padding: 0; border: 0; border-radius: 50%;
                      background: transparent; color: var(--sc-ink-2); cursor: pointer; }
  :global(.fd-save:active) { transform: scale(.9); }
  :global(.fd-save.is-on) { color: var(--sc-blue); }
  :global(.fd-card) { height: 100%; scroll-snap-align: start; scroll-snap-stop: always; display: grid; grid-template-rows: minmax(0, 1fr) auto; padding: 56px var(--gutter) 0; overflow: hidden; }
  :global(.fd-inner) { width: 100%; max-width: 520px; margin: 0 auto; min-height: 0; display: flex; flex-direction: column; gap: 10px; padding-bottom: 4px; overflow-y: auto; overscroll-behavior: contain; }
  :global(.fd-inner > :first-child) { margin-top: auto; }
  :global(.fd-inner > :last-child) { margin-bottom: auto; }
  :global(.fd-inner > *) { flex: none; }
  :global(.fd-kind) { margin: 0; font-size: .78rem; font-weight: 700; color: var(--sc-blue); text-transform: uppercase; letter-spacing: .04em; }
  :global(.fd-kind span) { color: var(--sc-ink-2); text-transform: none; letter-spacing: 0; }
  :global(.fd-q) { font-size: clamp(1.05rem, 4.8vw, 1.3rem); margin: 0; line-height: 1.3; }
  :global(.fd-q:focus) { outline: none; }
  :global(.fd-opts), :global(.fd-tf) { display: grid; gap: 8px; }   /* 8 px between answers, so a thumb does not hit the next one */
  :global(.fd-tf) { grid-template-columns: 1fr 1fr; }
  :global(.fd-opt) { min-height: 46px; padding: 8px 14px; border-radius: 14px; border: 2px solid var(--sc-line); background: var(--sc-panel); color: var(--sc-ink);
                     font: inherit; font-weight: 600; line-height: 1.3; text-align: left; cursor: pointer; box-shadow: 0 3px 0 var(--sc-line); }
  :global(.fd-opt:not(:disabled):hover) { border-color: var(--sc-blue); }
  :global(.fd-opt:disabled) { cursor: default; }
  :global(.fd-tf .fd-opt) { text-align: center; font-weight: 800; }
  :global(.fd-opt.is-right) { border-color: var(--sc-leaf); background: var(--sc-leaf-lt); }
  :global(.fd-opt.is-wrong) { border-color: var(--sc-clay); background: var(--sc-clay-lt); }
  /* once answered, the answers that are neither the right one nor the one chosen shrink to a line, to leave room for the reason */
  :global(.fd-opt.is-dim) { opacity: .55; min-height: 34px; padding: 4px 12px; font-size: .85rem; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; box-shadow: none; }
  :global(.fd-statement) { padding: 16px; border-radius: 20px; background: var(--sc-panel); box-shadow: 0 4px 0 var(--sc-line); touch-action: pan-y; user-select: none;
                           transition: transform .15s ease-out, background .15s; cursor: grab; }
  :global(.fd-statement p) { margin: 0 0 6px; font: 800 clamp(1.05rem, 4.8vw, 1.3rem)/1.35 var(--font-head); }
  :global(.fd-statement small) { color: var(--sc-ink-2); }
  :global(.fd-statement.lean-t) { background: var(--sc-leaf-lt); }
  :global(.fd-statement.lean-f) { background: var(--sc-clay-lt); }
  :global(.fd-result) { padding: 10px 12px; border-radius: 14px; background: var(--sc-panel); box-shadow: 0 3px 0 var(--sc-line); display: grid; gap: 3px; font-size: .95rem; line-height: 1.35; }
  :global(.fd-result.ok) { box-shadow: inset 4px 0 0 var(--sc-leaf), 0 3px 0 var(--sc-line); }
  :global(.fd-result.no) { box-shadow: inset 4px 0 0 var(--sc-clay), 0 3px 0 var(--sc-line); }
  :global(.fd-result p) { margin: 0; }
  :global(.fd-verdict::after) { content: '·'; margin: 0 6px; font-weight: 700; }
  :global(.fd-poll) { font-size: .8rem; font-weight: 700; color: var(--sc-ink-2); }
  /* a long reason cut to two lines (Reason in LearningFeed.tsx): the whole reason is the button that opens the rest */
  :global(.fd-whybtn) { position: relative; display: block; width: 100%; min-height: 44px; margin: 0; padding: 0; border: 0; background: none; color: inherit;
                        font: inherit; line-height: inherit; text-align: left; cursor: pointer; }
  :global(.fd-whybtn[aria-expanded="false"] .fd-whytext) { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  :global(.fd-moretag) { position: absolute; right: 0; bottom: 0; padding-left: 28px; font-weight: 800; color: var(--sc-blue);
                         background: linear-gradient(to right, transparent, var(--sc-panel) 24px); }
  :global(.fd-tip) { margin: 0; color: var(--sc-ink-2); }
  :global(.fd-note) { margin: 0; max-width: 420px; padding: 10px 14px; border-radius: 14px; background: var(--sc-mango-lt); color: var(--sc-ink); font-weight: 600; text-align: left; }
  /* the foot: where Next appears (a fixed height, so nothing moves when it does) */
  :global(.fd-foot) { width: 100%; max-width: 520px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; gap: 10px; height: 56px; }
  :global(.fd-foot a) { display: inline-flex; align-items: center; min-height: var(--tap); font-weight: 700; }
  :global(.fd-next) { margin-left: auto; min-height: 46px; }
  :global(.fd-cue) { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; color: var(--sc-ink-2); font-size: .85rem; font-weight: 700; pointer-events: none; }
  :global(.fd-cue i) { font-style: normal; font-size: 1.3rem; line-height: 1; color: var(--sc-blue); animation: fd-nudge 1.1s ease-in-out infinite; }
  @keyframes fd-nudge { 0%, 100% { transform: translateY(2px); opacity: .5; } 50% { transform: translateY(-4px); opacity: 1; } }
  :global(.fd-end .fd-inner) { text-align: center; align-items: center; }
  :global(.fd-big) { font: 800 2rem var(--font-head); margin: 0; }
  /* the picture takes what room is left: it is the first thing to shrink */
  :global(.fd-figure) { display: block; width: 100%; flex: 0 1 auto; min-height: 0; max-height: 30dvh; border-radius: 16px; background: var(--sc-panel); box-shadow: 0 3px 0 var(--sc-line); }
  :global(.fd-end .fd-inner .btn) { width: 100%; max-width: 360px; min-height: 48px; }
  /* on a phone the bottom bar (BottomNav) sits under the feed */
  @media (max-width: 760px) { :global(html) { --fd-bnav: calc(68px + env(safe-area-inset-bottom)); } }
  /* a short phone screen: tighter, so the longest question and its four answers still fit */
  @media (max-height: 700px) {
    :global(.fd-card) { padding-top: 44px; }
    :global(.fd-foot) { height: 48px; }
    :global(.fd-inner) { gap: 8px; }
    :global(.fd-opts), :global(.fd-tf) { gap: 8px; }
    :global(.fd-opt) { min-height: 44px; padding: 6px 12px; font-size: .95rem; box-shadow: 0 2px 0 var(--sc-line); }
    :global(.fd-opt.is-dim) { min-height: 34px; padding: 4px 12px; font-size: .85rem; box-shadow: none; }
    :global(.fd-q) { font-size: clamp(1rem, 4.4vw, 1.15rem); }
    :global(.fd-result) { padding: 8px 10px; font-size: .9rem; }
    :global(.fd-statement) { padding: 12px; }
    :global(.fd-statement small) { display: none; }
  }
  /* short screens: once answered, the label (and on the smallest, the poll line) gives way to the reason */
  @media (max-height: 700px) { :global(.fd-card.is-answered .fd-kind) { display: none; } }
  @media (max-height: 600px) { :global(.fd-card.is-answered .fd-poll) { display: none; } :global(.fd-result) { font-size: .88rem; } }
  @media (max-width: 340px) { :global(.fd-opt) { font-size: .9rem; } :global(.fd-score) { font-size: .8rem; padding: 5px 10px; } }
  /* a phone on its side: no bottom bar, a slimmer header, and the picture beside the question */
  @media (max-height: 500px) and (orientation: landscape) {
    :global(html) { --fd-bnav: 0px; --fd-head: 44px; }
    :global(.bnav) { display: none; }
    .fd-header { height: calc(44px + env(safe-area-inset-top)); }
    :global(.fd-card) { padding-top: 40px; }
    :global(.fd-foot) { height: 44px; }
    :global(.fd-inner) { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); align-content: safe center; gap: 6px 16px; max-width: 760px; }
    :global(.fd-inner > *) { grid-column: 1; }
    :global(.fd-inner > .fd-kind) { grid-column: 1 / -1; }
    :global(.fd-inner > .fd-opts), :global(.fd-inner > .fd-tf) { grid-column: 2; grid-row: 2 / span 4; align-self: center; }
    :global(.fd-end .fd-inner) { display: flex; }
    :global(.fd-opts) { gap: 8px; }
    :global(.fd-opt) { min-height: 44px; padding: 4px 12px; }
    :global(.fd-opt.is-dim) { min-height: 34px; padding: 2px 12px; }
    :global(.fd-foot) { max-width: 760px; }
  }
  /* the chapter list: an ordinary page, not a reel */
  :global(html.fd-deep .fd-listpage) { visibility: hidden; }
  :global(.fd-listpage) { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; gap: 12px; padding: 20px var(--gutter) 28px; text-align: center; }
  :global(.fd-pools) { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; width: 100%; max-width: 420px; text-align: left; }
  :global(.fd-pools h3) { margin: 10px 0 0; font-size: .85rem; color: var(--sc-ink-2); text-transform: uppercase; letter-spacing: .04em; }
  :global(.fd-pools .btn) { justify-content: space-between; flex-wrap: wrap; gap: 2px 10px; min-width: 0; min-height: 48px; text-align: left; white-space: normal; }   /* narrow: the count goes under the name */
  :global(.fd-pools .btn small) { color: var(--sc-ink-2); font-weight: 600; white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { :global(.fd-statement) { transition: none; } :global(.fd-cue i) { animation: none; } :global(.fd-save:active) { transform: none; } }
</style>
