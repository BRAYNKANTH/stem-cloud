        "type": {
          "const": "activities",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "heading",
        "body"
      ],
      "title": "ActivitiesStep",
      "type": "object"
    },
    "BasicsStep": {
      "additionalProperties": false,
      "properties": {
        "cards": {
          "items": {
            "$ref": "#/$defs/Card"
          },
          "minItems": 1,
          "title": "Cards",
          "type": "array"
        },
        "extra": {
          "default": [],
          "description": "Further content after the cards (a home activity, a bridge to the notes), kept as it is.",
