{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "cd web && npm ci && npm run build",
  "outputDirectory": "web/dist",
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=31536000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/shell/learn/(.*)",
      "destination": "/learn/$1",
      "permanent": false
    },
    {
      "source": "/shell/feed(.*)",
      "destination": "/feed/",
      "permanent": false
    },
    {
      "source": "/shell/formulas(.*)",
      "destination": "/formulas/",
      "permanent": false
    },
    {
      "source": "/shell/past-papers(.*)",
      "destination": "/past-papers/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{site,public,stemcloud,content/past-papers,content/feed,web/dist/home,web/dist/shell,web/dist-private}/**",
      "maxDuration": 30,
      "excludeFiles": "web/{node_modules,src,scripts,.astro,dist/_astro,dist/static}/**"
    }
  }
}
