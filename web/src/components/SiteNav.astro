---
// Top bar of the public Home and About pages: logo, page links, theme switch and Log in / My Lessons.
// On phones the links wrap under the logo (as on the current pages). Extra buttons can be passed in the "actions" slot.
import ThemeToggle from '../islands/ThemeToggle';
import AuthButton from '../islands/AuthButton';

interface Props {
  links: { href: string; label: string; active?: boolean }[];
}
const { links } = Astro.props;
---
<nav class="site-nav" aria-label="Main">
  <div class="wrap nav-inner">
    <a href="/" class="nav-brand">
      <img src="/static/brand/logo-mark.png" alt="" width="44" height="29" />
      <span>STEM <b>Cloud</b></span>
    </a>
    <ul class="nav-links">
      {links.map((l) => <li><a href={l.href} aria-current={l.active ? 'page' : undefined}>{l.label}</a></li>)}
    </ul>
    <div class="nav-actions">
      <slot name="actions" />
      <ThemeToggle client:idle />
      <AuthButton client:idle />
    </div>
  </div>
</nav>

<style>
  .site-nav {
    position: sticky; top: 0; z-index: 200;
    background: color-mix(in srgb, var(--sc-ground) 88%, transparent);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--sc-line);
    padding-top: env(safe-area-inset-top);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; min-height: 72px; gap: 20px; }
  .nav-brand { display: flex; align-items: center; gap: 12px; min-height: var(--tap); font-family: var(--font-head); font-weight: 800;
               font-size: 1.35rem; color: var(--sc-ink); text-decoration: none; white-space: nowrap; }
  .nav-brand b { color: var(--sc-blue); font-weight: 800; }
  .nav-links { display: flex; align-items: center; gap: 24px; list-style: none; margin: 0; padding: 0; }
  .nav-links a { color: var(--sc-ink-2); font-weight: 700; font-size: .95rem; min-height: var(--tap); display: inline-flex; align-items: center; text-decoration: none; }
  .nav-links a:hover, .nav-links a[aria-current="page"] { color: var(--sc-ink); }
  .nav-actions { display: flex; align-items: center; gap: 12px; }
  .nav-actions :global(.btn) { white-space: nowrap; }
  .nav-actions :global(.theme-toggle) {
    width: var(--tap); height: var(--tap); border-radius: var(--r); border: 2px solid var(--sc-line); background: var(--sc-panel);
    color: var(--sc-ink-2); display: inline-flex; align-items: center; justify-content: center; font-size: 1.15rem; cursor: pointer;
    box-shadow: 0 3px 0 var(--sc-line);
  }
  @media (max-width: 720px) {
    .nav-inner { min-height: 60px; flex-wrap: wrap; gap: 6px 12px; padding-block: 8px; }
    .nav-actions { gap: 8px; margin-left: auto; }
    .nav-links { order: 5; width: 100%; flex-wrap: wrap; gap: 0 16px; }
  }
</style>
