---
// Generated by tools/challenge_games.py: the island of a challenge game (components/lesson/Step.astro).
import type { SiDict } from '../../lib/si-lookup';
import HydrostaticPressureGame from './HydrostaticPressureGame';
import WorkEnergyPowerGame from './WorkEnergyPowerGame';
import CurrentElectricityGame from './CurrentElectricityGame';
import WavesGame from './WavesGame';
import GeometricalOpticsGame from './GeometricalOpticsGame';
import HeatGame from './HeatGame';
import ElectricAppliancesGame from './ElectricAppliancesGame';
import ElectronicsGame from './ElectronicsGame';
import ElectromagnetismGame from './ElectromagnetismGame';
interface Props { island: string; si: SiDict; stepId: string }
const { island, si, stepId } = Astro.props;
---
{island === 'hydrostatic-pressure' && <HydrostaticPressureGame client:visible si={si} stepId={stepId} />}
{island === 'work-energy-power' && <WorkEnergyPowerGame client:visible si={si} stepId={stepId} />}
{island === 'current-electricity' && <CurrentElectricityGame client:visible si={si} stepId={stepId} />}
{island === 'waves' && <WavesGame client:visible si={si} stepId={stepId} />}
{island === 'geometrical-optics' && <GeometricalOpticsGame client:visible si={si} stepId={stepId} />}
{island === 'heat' && <HeatGame client:visible si={si} stepId={stepId} />}
{island === 'electric-appliances' && <ElectricAppliancesGame client:visible si={si} stepId={stepId} />}
{island === 'electronics' && <ElectronicsGame client:visible si={si} stepId={stepId} />}
{island === 'electromagnetism' && <ElectromagnetismGame client:visible si={si} stepId={stepId} />}
