---
// Login page. Built under /shell/ because the Python route /login decides first: a student who is already
// signed in goes straight on (safe ?next=), everyone else gets this page (stemcloud/routers/pages.py).
// Text from public/static/login.html, unchanged.
import AppLayout from '../../layouts/AppLayout.astro';
import Icon from '../../components/Icon.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import LoginTour from '../../components/LoginTour.astro';
import LoginForm from '../../islands/LoginForm';

const WA_ENROLL = 'https://wa.me/94707752433?text=Hello%20Admin,%20I%20would%20like%20to%20enroll%20in%20STEM%20Cloud%20Physics.%20My%20name%20is:%20';
const WA_DETAILS = 'https://wa.me/94707752433?text=Hello%20Admin,%20I%20would%20like%20to%20enroll%20in%20STEM%20Cloud%20Physics.%20Please%20share%20the%20details.%20My%20name%20is:%20';
---
<AppLayout title="STEM Cloud · Log in" description="Log in to STEM Cloud with the account your teacher or admin gave you." noindex>
  <div class="wrap narrow login">
    <header class="lhero">
      <img class="lmark" src="/static/brand/logo-mark.png" alt="STEM Cloud logo" width="168" height="109" />
      <h1 class="lname">STEM <span>Cloud</span></h1>
      <nav class="lhero-links" aria-label="Pages">
        <a href="/">← Homepage</a><span aria-hidden="true">·</span><a href="/about">About Platform</a>
      </nav>
      <button class="tour-trigger" type="button" data-open-tour>Explore App Tour &amp; Previews</button>
    </header>

    <section class="card" aria-labelledby="signin-h">
      <h2 id="signin-h">Sign in to your account</h2>
      <p class="sub">Enter the credentials provided by your teacher or admin.</p>
      <LoginForm client:load />
    </section>

    <aside class="notice-box">
      <Icon name="help" />
      <div><strong>Need an account?</strong> Contact the site administrator on WhatsApp at <strong>070 775 2433</strong> to enroll and receive your login credentials.</div>
    </aside>

    <div class="foot">
      Your lessons and saved questions are saved to your account.<br />
      Need an account? <a href={WA_ENROLL} target="_blank" rel="noopener noreferrer">Chat on WhatsApp (070 775 2433)</a><br />
      Forgot your password? Ask your teacher or site admin to reset it.
      <nav class="foot-links" aria-label="About STEM Cloud">
        <a href="/">Home</a> · <a href="/about">About STEM Cloud</a> · <a href="/privacy">Privacy Policy</a> · <a href="/terms">Terms</a>
      </nav>
    </div>
  </div>

  <a href={WA_DETAILS} target="_blank" rel="noopener noreferrer" class="wa-float" aria-label="Contact Admin on WhatsApp to get an account">
    <WhatsAppIcon /><span>Get Account</span><span class="wa-badge">070 775 2433</span>
  </a>

  <dialog class="tour" id="tour" aria-labelledby="tour-title">
    <div class="tour-header">
      <h2 id="tour-title">STEM Cloud App Tour</h2>
      <button class="tour-close" type="button" data-close-tour aria-label="Close tour"><Icon name="close" /></button>
    </div>
    <div class="tour-body"><LoginTour /></div>
    <div class="tour-footer">
      <div class="tour-dots" role="group" aria-label="Tour slides">
        {[1, 2, 3, 4, 5].map((n) => <button type="button" class="tour-dot" data-go={n - 1} aria-label={`Slide ${n}`}></button>)}
      </div>
      <div class="tour-nav-btns">
        <button class="btn btn-sm" type="button" data-prev>Previous</button>
        <button class="btn btn-sm primary" type="button" data-next>Next →</button>
      </div>
    </div>
  </dialog>
</AppLayout>

<script>
  // App Tour: five slides in a native <dialog> (Escape closes it, focus stays inside). Opened by the button or #tour.
  const dlg = document.getElementById('tour') as HTMLDialogElement;
  const slides = [...dlg.querySelectorAll<HTMLElement>('.tour-slide')];
  const dots = [...dlg.querySelectorAll<HTMLButtonElement>('.tour-dot')];
  const prev = dlg.querySelector<HTMLButtonElement>('[data-prev]')!;
  const next = dlg.querySelector<HTMLButtonElement>('[data-next]')!;
  let at = 0;
  const show = (i: number) => {
    at = Math.max(0, Math.min(slides.length - 1, i));
    slides.forEach((s, k) => s.classList.toggle('active', k === at));
    dots.forEach((d, k) => { d.classList.toggle('active', k === at); d.setAttribute('aria-current', k === at ? 'step' : 'false'); });
    prev.disabled = at === 0;
    next.textContent = at === slides.length - 1 ? 'Close Tour' : 'Next →';
  };
  const open = () => { show(0); dlg.showModal(); };
  document.querySelector('[data-open-tour]')!.addEventListener('click', open);
  dlg.querySelector('[data-close-tour]')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });           // click on the backdrop
  prev.addEventListener('click', () => show(at - 1));
  next.addEventListener('click', () => (at < slides.length - 1 ? show(at + 1) : dlg.close()));
  dots.forEach((d) => d.addEventListener('click', () => show(Number(d.dataset.go))));
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') next.click();
    if (e.key === 'ArrowLeft' && !prev.disabled) prev.click();
  });
  show(0);
  if (location.hash === '#tour') open();
</script>

<style>
  .login { padding-top: max(20px, env(safe-area-inset-top)); padding-bottom: 96px; }
  .lhero { text-align: center; padding: 10px 0 20px; }
  .lmark { display: block; width: 168px; max-width: 52vw; height: auto; margin: 0 auto 6px; }
  .lname { font-size: 2rem; margin: 6px 0 4px; }
  .lname span { color: var(--sc-blue); }
  .lhero-links { display: flex; justify-content: center; align-items: center; gap: 14px; font-weight: 700; font-size: .9rem; color: var(--sc-ink-2); }
  .lhero-links a { min-height: var(--tap); display: inline-flex; align-items: center; }
  .tour-trigger { margin-top: 10px; min-height: var(--tap); padding: 0 18px; border: 0; border-radius: 999px; background: var(--sc-mango-lt); color: #16183D;
                  box-shadow: 0 3px 0 var(--sc-mango); font: inherit; font-weight: 800; cursor: pointer; }
  .card h2 { font-size: 1.2rem; margin: 0 0 4px; }
  .sub { margin: 0 0 6px; color: var(--sc-ink-2); font-size: .9rem; }

  /* form (island markup) */
  .login :global(label) { display: block; font-weight: 700; font-size: .9rem; margin: 14px 0 5px; }
  .login :global(input[type=text]), .login :global(input[type=password]) { width: 100%; font: inherit; font-size: 1rem; color: var(--sc-ink); background: var(--sc-field);
      border: 2px solid var(--sc-line); border-radius: 12px; padding: 12px 14px; min-height: 48px; }
  .login :global(input:focus-visible) { border-color: var(--sc-blue); }
  .login :global(.pw-wrap) { position: relative; }
  .login :global(.pw-wrap input) { padding-right: 56px; }
  .login :global(.eye) { position: absolute; right: 4px; top: 50%; transform: translateY(-50%); width: var(--tap); height: var(--tap); border: 0; border-radius: 10px;
      background: none; color: var(--sc-ink-2); font-size: 1.15rem; cursor: pointer; }
  .login :global(.btn.full) { width: 100%; margin-top: 18px; min-height: 50px; font-size: 1.02rem; }
  .login :global(.btn:disabled) { opacity: .6; cursor: wait; }
  .login :global(.msg) { margin-top: 12px; font-size: .92rem; min-height: 1.2em; }
  .login :global(.msg.err) { color: var(--sc-clay); font-weight: 700; }
  .login :global(.msg.ok) { color: var(--sc-leaf); font-weight: 700; }
  .login :global(.install-row) { text-align: center; margin: 16px 0 0; }

  .notice-box { display: flex; align-items: center; gap: 10px; margin: 16px 0; padding: 12px 14px; border-radius: 14px; background: var(--sc-panel-2);
                color: var(--sc-ink-2); font-size: .9rem; }
  .notice-box :global(.ic) { color: var(--sc-blue); font-size: 1.2rem; }
  .foot { color: var(--sc-ink-2); font-size: .85rem; text-align: center; margin-top: 18px; line-height: 1.7; }
  .foot-links { margin-top: 8px; }
  .foot-links a { display: inline-flex; align-items: center; min-height: var(--tap); }

  .wa-float { position: fixed; bottom: max(20px, env(safe-area-inset-bottom)); right: 20px; z-index: 900; display: inline-flex; align-items: center; gap: 10px;
              min-height: var(--tap); background: #1F8A4C; color: #fff; padding: 10px 18px; border-radius: 999px; font-weight: 800; text-decoration: none;
              box-shadow: 0 4px 0 #145C33; }
  .wa-float :global(.wa-ic) { width: 22px; height: 22px; }
  .wa-badge { background: rgba(0, 0, 0, .18); padding: 2px 8px; border-radius: 99px; font-size: .78rem; font-weight: 700; }
  @media (max-width: 480px) { .wa-float { right: 16px; padding: 10px 14px; } .wa-badge { display: none; } }

  /* dialogs: tour (static) and device limit (island) */
  .tour, .login :global(.device-dialog) { border: 0; border-radius: 22px; padding: 0; background: var(--sc-panel); color: var(--sc-ink); box-shadow: 0 24px 60px rgba(0, 0, 0, .35); }
  .tour::backdrop, .login :global(.device-dialog::backdrop) { background: rgba(8, 14, 26, .7); backdrop-filter: blur(6px); }
  .tour { width: min(560px, calc(100% - 24px)); max-height: 92vh; }
  .tour[open] { display: flex; flex-direction: column; }
  .tour-header { display: flex; align-items: center; justify-content: space-between; padding: 12px 12px 12px 20px; border-bottom: 1px solid var(--sc-line); }
  .tour-header h2 { margin: 0; font-size: 1.15rem; }
  .tour-close { width: var(--tap); height: var(--tap); border: 0; border-radius: 10px; background: none; color: var(--sc-ink-2); font-size: 1.2rem; cursor: pointer; }
  .tour-body { overflow-y: auto; padding: 20px; flex: 1; }
  .tour-body :global(.tour-slide) { display: none; }
  .tour-body :global(.tour-slide.active) { display: block; }
  .tour-body :global(.tour-preview-card) { background: var(--sc-panel-2); border-radius: 16px; padding: 18px; text-align: center; }
  .tour-body :global(.tour-graphic) { min-height: 130px; display: flex; align-items: center; justify-content: center; margin-bottom: 12px; border-radius: 12px; background: #0F1230; overflow: hidden; }
  .tour-body :global(.tour-graphic svg) { max-width: 100%; height: auto; }
  .tour-body :global(h4) { margin: 0 0 8px; font-size: 1.2rem; }
  .tour-body :global(p) { margin: 0 0 12px; color: var(--sc-ink-2); font-size: .92rem; line-height: 1.5; }
  .tour-body :global(.tour-feature-tags) { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; }
  .tour-body :global(.tour-feature-tags span) { display: inline-flex; align-items: center; gap: 4px; font-size: .8rem; font-weight: 700; padding: 4px 10px; border-radius: 99px;
      background: var(--sc-panel); color: var(--sc-ink-2); }
  .tour-body :global(.btn-whatsapp) { background: #1F8A4C; color: #fff; border: 0; box-shadow: 0 4px 0 #145C33; width: 100%; white-space: normal; }
  .tour-footer { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 16px; border-top: 1px solid var(--sc-line); }
  .tour-dots { display: flex; }
  .tour-dot { width: 28px; height: var(--tap); border: 0; background: none; cursor: pointer; padding: 0; display: inline-flex; align-items: center; justify-content: center; }
  .tour-dot::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--sc-line); }
  .tour-dot.active::before { width: 20px; border-radius: 99px; background: var(--sc-blue); }
  .tour-nav-btns { display: flex; gap: 8px; }

  .login :global(.device-dialog) { width: min(460px, calc(100% - 24px)); padding: 24px; }
  .login :global(.device-icon) { display: flex; justify-content: center; gap: 4px; font-size: 2.2rem; color: var(--sc-clay); margin-bottom: 8px; }
  .login :global(.device-dialog h2) { text-align: center; font-size: 1.25rem; margin: 0 0 6px; }
  .login :global(.device-dialog > p) { text-align: center; color: var(--sc-ink-2); font-size: .9rem; margin: 0 0 16px; }
  .login :global(.device-list) { max-height: 220px; overflow-y: auto; margin-bottom: 14px; }
  .login :global(.device-row) { display: flex; align-items: center; justify-content: space-between; gap: 12px; background: var(--sc-panel-2); border-radius: 14px; padding: 10px 12px; margin-bottom: 10px; }
  .login :global(.device-info b) { display: block; font-size: .95rem; }
  .login :global(.device-info small) { color: var(--sc-ink-2); font-size: .82rem; }
  .login :global(.device-actions) { display: grid; gap: 8px; }
  .login :global(.device-actions .btn.full) { margin-top: 0; min-height: var(--tap); }
  .login :global(.btn.bad) { border-color: var(--sc-clay); color: var(--sc-clay); }
  .login :global(.device-empty) { color: var(--sc-ink-2); text-align: center; font-size: .9rem; }
</style>
