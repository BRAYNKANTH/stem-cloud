  "$id": "https://www.stemcloud.site/schemas/lesson-2.json",
  "additionalProperties": false,
  "properties": {
    "grade": {
      "maximum": 13,
      "minimum": 6,
      "title": "Grade",
      "type": "integer"
    },
    "id": {
      "description": "Global, stable: \"<subject>.g<grade>.<slug>\".",
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "legacy": {
      "anyOf": [
        {
          "$ref": "#/$defs/LegacyRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "number": {
      "description": "Chapter or unit number as printed in the textbook, e.g. \"5\" or \"2\".",
      "title": "ChapterNumber",
      "type": "string"
    },
    "schema": {
      "const": 2,
      "title": "Schema",
      "type": "integer"
    },
    "slug": {
      "pattern": "^[a-z0-9-]+$",
      "title": "Slug",
      "type": "string"
    },
    "steps": {
      "items": {
        "discriminator": {
          "mapping": {
            "activities": "#/$defs/ActivitiesStep",
            "basics": "#/$defs/BasicsStep",
            "exercises": "#/$defs/ExercisesStep",
            "game": "#/$defs/InteractiveStep",
            "lab": "#/$defs/InteractiveStep",
            "notes": "#/$defs/NotesStep",
            "quiz": "#/$defs/QuizStep",
            "recap": "#/$defs/RecapStep",
            "sort": "#/$defs/InteractiveStep",
            "story": "#/$defs/StoryStep",
            "summary": "#/$defs/SummaryStep",
            "watch": "#/$defs/WatchStep",
            "worked": "#/$defs/WorkedStep"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/StoryStep"
          },
          {
            "$ref": "#/$defs/BasicsStep"
          },
          {
            "$ref": "#/$defs/WatchStep"
          },
          {
            "$ref": "#/$defs/NotesStep"
          },
          {
            "$ref": "#/$defs/ActivitiesStep"
          },
          {
            "$ref": "#/$defs/InteractiveStep"
          },
          {
            "$ref": "#/$defs/QuizStep"
          },
          {
            "$ref": "#/$defs/WorkedStep"
          },
          {
            "$ref": "#/$defs/ExercisesStep"
          },
          {
            "$ref": "#/$defs/RecapStep"
          },
          {
            "$ref": "#/$defs/SummaryStep"
          }
        ]
