        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Textbook section number, e.g. \"2.1\".",
          "title": "Section"
        },
        "title": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "title",
        "body"
      ],
      "title": "Card",
      "type": "object"
    },
    "Exercise": {
      "additionalProperties": false,
