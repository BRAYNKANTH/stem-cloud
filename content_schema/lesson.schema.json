    "InteractiveStep": {
      "additionalProperties": false,
      "description": "A lab or game, still the lesson page's own (legacy) until it is rebuilt.",
      "properties": {
        "heading": {
          "$ref": "#/$defs/Heading"
        },
        "id": {
          "maxLength": 120,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Which game, e.g. \"pushit\", \"tugofwar\".",
          "title": "Kind"
        },
        "legacy": {
          "$ref": "#/$defs/Legacy"
        },
        "type": {
          "enum": [
            "lab",
            "game",
            "sort"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "heading",
        "legacy"
      ],
      "title": "InteractiveStep",
      "type": "object"
    },
    "Legacy": {
      "additionalProperties": false,
      "description": "A part still served by the existing lesson page, shown in a frame: /lessons/<file>?embed=1#<hash>.",
      "properties": {
        "file": {
          "pattern": "^[a-z0-9-]+\\.html$",
          "title": "LessonFile",
          "type": "string"
        },
        "hash": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Hash",
          "type": "string"
        }
      },
      "required": [
        "file",
        "hash"
      ],
      "title": "Legacy",
      "type": "object"
    },
    "LegacyRef": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "pattern": "^[a-z0-9-]+\\.html$",
          "title": "LessonFile",
          "type": "string"
        },
        "id": {
          "description": "The id the current lesson page stores progress under, e.g. \"c5\".",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "file"
      ],
      "title": "LegacyRef",
      "type": "object"
    },
