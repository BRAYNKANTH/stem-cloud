---
// The formula cards (the FormulaCards island): every formula of the lessons, with units and a worked example, in the
// three languages (content/formulas/physics.json; tests/test_formula_cards.py keeps it with the lessons). Login-only
// like the lessons: web/scripts/private.mjs moves the built page out of the published files and the Python route
// /formulas serves it after checking the sign-in (stemcloud/routers/past_papers.py). A lesson's step bar links here
// with its chapter (#<chapter>).
import AppLayout from '../../../layouts/AppLayout.astro';
import FormulaCards, { type Card, type Chapter } from '../../../islands/FormulaCards';
import LangSwitch from '../../../islands/LangSwitch';
import ThemeToggle from '../../../islands/ThemeToggle';
import XpChip from '../../../islands/XpChip';
import catalog from '../../../../../content/catalog.json';
import data from '../../../../../content/formulas/physics.json';

interface Entry { id: string; subject: string; grade: number; number: string; slug: string; title: Chapter['title']; legacy?: { file: string } }
const chapters: Chapter[] = (catalog.lessons as Entry[])
  .filter((l) => l.subject === 'physics')
  .map((l) => ({ id: l.id, slug: l.slug, grade: l.grade, number: l.number, title: l.title, url: `/learn/${l.subject}/g${l.grade}/${l.slug}/`,
                 papers: (l.legacy?.file ?? '').replace(/\.html$/, '') }))
  .sort((a, b) => a.grade - b.grade || Number(a.number) - Number(b.number));
const cards = data.cards as Card[];
---
<AppLayout title="Formula Cards · STEM Cloud" description="Every O/L Physics formula, with its units and a worked example, in English, Tamil and Sinhala." noindex>
  <header class="fc-header" slot="header">
    <a class="fc-home" href="/lessons/index.html">← <span data-l="en">Learn</span><span data-l="ta" lang="ta">படி</span><span data-l="si" lang="si">ඉගෙනුම</span></a>
    <div class="fc-header-right">
      <XpChip client:idle />
      <LangSwitch client:idle />
      <ThemeToggle client:idle />
    </div>
  </header>
  <div class="wrap narrow fc-page">
    <FormulaCards client:load cards={cards} chapters={chapters} />
  </div>
</AppLayout>

<style>
  .fc-header { position: sticky; top: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: env(safe-area-inset-top) var(--gutter) 0;
               min-height: 60px; background: var(--sc-ground); border-bottom: 1px solid var(--sc-line); }
  .fc-header-right { display: flex; gap: 8px; align-items: center; }
  .fc-header :global(.theme-toggle) { width: var(--tap); height: var(--tap); border-radius: var(--r); border: 2px solid var(--sc-line); background: var(--sc-panel); color: var(--sc-ink); cursor: pointer; }
  .fc-header :global(.xp-chip) { display: inline-flex; align-items: center; gap: 4px; min-height: var(--tap); padding: 0 10px; border-radius: 999px; background: var(--sc-mango-lt); font-weight: 700; font-size: .9rem; }
  @media (max-width: 480px) { .fc-header :global(.xp-word) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); } }
  .fc-home { display: inline-flex; align-items: center; gap: 4px; min-height: var(--tap); font-weight: 700; text-decoration: none; }
  html:not([lang="ta"]):not([lang="si"]) .fc-home [data-l]:not([data-l="en"]),
  html[lang="ta"] .fc-home [data-l]:not([data-l="ta"]),
  html[lang="si"] .fc-home [data-l]:not([data-l="si"]) { display: none; }
  .fc-page { padding-block: 16px 48px; }

  .fc-page :global(h1) { font-size: 1.8rem; margin: 4px 0 4px; }
  .fc-page :global(.fc-lead) { color: var(--sc-ink-2); margin: 0 0 14px; }
  /* the chapters: one row that scrolls sideways inside itself, never the page */
  .fc-page :global(.fc-chips) { display: flex; gap: 8px; overflow-x: auto; padding: 2px 2px 10px; margin: 0 calc(-1 * var(--gutter)); padding-inline: var(--gutter); scrollbar-width: thin; }
  .fc-page :global(.fc-chips button) { flex: 0 0 auto; min-height: var(--tap); padding: 0 14px; border-radius: 999px; border: 2px solid var(--sc-line); background: var(--sc-panel);
      color: var(--sc-ink); font: inherit; font-weight: 600; font-size: .9rem; cursor: pointer; white-space: nowrap; }
  .fc-page :global(.fc-chips button small) { color: var(--sc-ink-2); font-weight: 700; margin-right: 2px; }
  .fc-page :global(.fc-chips button[aria-pressed="true"]) { background: var(--sc-ink); border-color: var(--sc-ink); color: var(--sc-ground); }
  .fc-page :global(.fc-chips button[aria-pressed="true"] small) { color: inherit; }
  /* the view switch and "Test me" share a row; a longer Tamil or Sinhala label wraps inside its button, never past the screen */
  .fc-page :global(.fc-tools) { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; margin: 6px 0 12px; }
  .fc-page :global(.fc-test) { flex: 0 1 auto; min-width: 0; max-width: 100%; white-space: normal; text-align: center; line-height: 1.2; padding-block: 6px; }
  .fc-page :global(.fc-seg) { display: inline-flex; padding: 3px; gap: 3px; border-radius: 12px; background: var(--sc-panel-2); }
  .fc-page :global(.fc-seg button) { min-height: var(--tap); padding: 0 16px; border: 0; border-radius: 10px; background: none; color: var(--sc-ink-2); font: inherit; font-weight: 700; cursor: pointer; }
  .fc-page :global(.fc-seg button[aria-pressed="true"]) { background: var(--sc-panel); color: var(--sc-ink); box-shadow: 0 2px 0 var(--sc-line); }
  .fc-page :global(.fc-note) { margin: 0 0 12px; padding: 10px 14px; border-radius: 12px; background: var(--sc-mango-lt); font-size: .92rem; }

  /* the deck: one card per screen, swiped */
  .fc-page :global(.fc-deck) { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; align-items: flex-start;
      margin: 0 calc(-1 * var(--gutter)); padding: 4px var(--gutter) 8px; scroll-padding-inline: var(--gutter); }
  .fc-page :global(.fc-deck::-webkit-scrollbar) { display: none; }
  .fc-page :global(.fc-deck .fc-card) { flex: 0 0 100%; scroll-snap-align: start; }
  .fc-page :global(.fc-card) { background: var(--sc-panel); border-radius: 22px; box-shadow: 0 3px 0 var(--sc-line); padding: 20px; min-width: 0; }
  .fc-page :global(.fc-chap) { margin: 0 0 6px; color: var(--sc-ink-2); font-size: .8rem; font-weight: 700; letter-spacing: .02em; }
  .fc-page :global(.fc-name) { font-size: 1.35rem; margin: 0 0 14px; }
  .fc-page :global(.fc-math) { margin: 0 0 16px; padding: 18px 14px; border-radius: 16px; background: var(--sc-blue-lt); color: var(--sc-ink); text-align: center;
      font-family: var(--font-head); font-weight: 800; font-size: clamp(1.4rem, 6vw, 2rem); line-height: 1.25; overflow-wrap: anywhere; }
  .fc-page :global(.fc-sym) { width: 100%; border-collapse: collapse; margin: 0 0 14px; font-size: .92rem; }
  .fc-page :global(.fc-sym th), .fc-page :global(.fc-sym td) { padding: 8px 6px; border-bottom: 1px solid var(--sc-line); text-align: left; vertical-align: top; }
  .fc-page :global(.fc-sym thead th) { color: var(--sc-ink-2); font-size: .78rem; font-weight: 700; }
  .fc-page :global(.fc-sym tbody th) { font-family: var(--font-head); font-size: 1.05rem; white-space: nowrap; }
  .fc-page :global(.fc-unit) { white-space: nowrap; color: var(--sc-ink-2); font-variant-numeric: tabular-nums; }
  .fc-page :global(.fc-ex) { margin: 0 0 10px; padding: 12px 14px; border-radius: 14px; background: var(--sc-leaf-lt); }
  .fc-page :global(.fc-ex b) { display: block; font-size: .78rem; color: var(--sc-ink-2); margin-bottom: 2px; }
  .fc-page :global(.fc-tip) { margin: 0 0 10px; color: var(--sc-ink-2); font-size: .92rem; }
  .fc-page :global(.fc-reveal) { width: 100%; min-height: 96px; margin: 0 0 14px; border-style: dashed; font-size: 1rem; }
  .fc-page :global(.fc-links) { display: flex; flex-wrap: wrap; gap: 4px 16px; margin: 6px 0 0; }
  .fc-page :global(.fc-links a) { display: inline-flex; align-items: center; min-height: var(--tap); font-weight: 700; font-size: .92rem; }
  .fc-page :global(.fc-pager) { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 8px; }
  .fc-page :global(.fc-pager .btn) { min-width: 64px; min-height: 48px; font-size: 1.2rem; }
  .fc-page :global(.fc-pager .btn:disabled) { opacity: .4; box-shadow: none; cursor: default; }
  .fc-page :global(.fc-count) { font-weight: 700; color: var(--sc-ink-2); font-variant-numeric: tabular-nums; }
  .fc-page :global(.fc-list) { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
</style>
