---
// Generated by tools/level_games.py: the island of a level game (components/lesson/Step.astro).
import type { SiDict } from '../../lib/si-lookup';
import EquilibriumGame from './EquilibriumGame';
import FrictionGame from './FrictionGame';
import MotionInAStraightLineGame from './MotionInAStraightLineGame';
import NewtonsLawsGame from './NewtonsLawsGame';
import ResultantForceGame from './ResultantForceGame';
import TurningEffectGame from './TurningEffectGame';
interface Props { island: string; si: SiDict }
const { island, si } = Astro.props;
---
{island === 'equilibrium' && <EquilibriumGame client:visible si={si} />}
{island === 'friction' && <FrictionGame client:visible si={si} />}
{island === 'motion-in-a-straight-line' && <MotionInAStraightLineGame client:visible si={si} />}
{island === 'newtons-laws' && <NewtonsLawsGame client:visible si={si} />}
{island === 'resultant-force' && <ResultantForceGame client:visible si={si} />}
{island === 'turning-effect' && <TurningEffectGame client:visible si={si} />}
