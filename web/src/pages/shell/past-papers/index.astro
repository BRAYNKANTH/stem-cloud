---
// Past papers on the new pages (the PastPapers island, ported from public/static/past-papers.js). Login-only like the
// lessons: after the build, web/scripts/private.mjs moves this page out of the published files, and the Python route
// /past-papers serves it after checking the sign-in (stemcloud/routers/past_papers.py).
import AppLayout from '../../../layouts/AppLayout.astro';
import PastPapers from '../../../islands/PastPapers';
import ThemeToggle from '../../../islands/ThemeToggle';
import '../../../styles/past-papers.css';
---
<AppLayout title="Past Papers · STEM Cloud" description="O/L Science past papers: the physics questions, with model answers." noindex>
  <header class="pp-header topbar" slot="header">
    <a href="/lessons/index.html">← STEM Cloud</a>
    <ThemeToggle client:idle />
  </header>
  <div class="pp-page">
    <a class="pp-skip" href="#pp-question">Skip to question</a>
    <div class="pp-main">
      <PastPapers client:load />
    </div>
  </div>
</AppLayout>

<style>
  .pp-header :global(.theme-toggle) { width: var(--tap); height: var(--tap); border-radius: var(--r); border: 2px solid var(--sc-line); background: var(--sc-panel); color: var(--sc-ink); cursor: pointer; }
  .pp-page :global(.pp-toggles) { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
  .pp-page :global(.pp-status) { padding: 24px 0; }
</style>
