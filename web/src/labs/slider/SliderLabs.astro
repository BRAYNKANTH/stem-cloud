---
// Generated by tools/slider_labs.py: the island of a slider lab (components/lesson/Step.astro).
import type { SiDict } from '../../lib/si-lookup';
import HydrostaticPressureLab from './HydrostaticPressureLab';
import WorkEnergyPowerLab from './WorkEnergyPowerLab';
import CurrentElectricityLab from './CurrentElectricityLab';
import WavesLab from './WavesLab';
import GeometricalOpticsLab from './GeometricalOpticsLab';
import HeatLab from './HeatLab';
import ElectricAppliancesLab from './ElectricAppliancesLab';
import ElectronicsLab from './ElectronicsLab';
import ElectromagnetismLab from './ElectromagnetismLab';
interface Props { island: string; si: SiDict; legacy?: string }
const { island, si, legacy } = Astro.props;
---
{island === 'hydrostatic-pressure' && <HydrostaticPressureLab client:visible si={si} legacy={legacy} />}
{island === 'work-energy-power' && <WorkEnergyPowerLab client:visible si={si} legacy={legacy} />}
{island === 'current-electricity' && <CurrentElectricityLab client:visible si={si} legacy={legacy} />}
{island === 'waves' && <WavesLab client:visible si={si} legacy={legacy} />}
{island === 'geometrical-optics' && <GeometricalOpticsLab client:visible si={si} legacy={legacy} />}
{island === 'heat' && <HeatLab client:visible si={si} legacy={legacy} />}
{island === 'electric-appliances' && <ElectricAppliancesLab client:visible si={si} legacy={legacy} />}
{island === 'electronics' && <ElectronicsLab client:visible si={si} legacy={legacy} />}
{island === 'electromagnetism' && <ElectromagnetismLab client:visible si={si} legacy={legacy} />}
