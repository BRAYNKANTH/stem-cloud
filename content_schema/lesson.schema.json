            "$ref": "#/$defs/Rich"
          },
          "title": "Extra",
          "type": "array"
        },
        "heading": {
          "$ref": "#/$defs/Heading"
        },
        "hook": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rich"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "maxLength": 120,
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "basics",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "heading",
        "cards"
      ],
      "title": "BasicsStep",
      "type": "object"
    },
    "Card": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "$ref": "#/$defs/Rich"
